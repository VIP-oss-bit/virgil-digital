<style>
  .guide-list { display:grid; gap:1rem; margin:2rem 0; } .guide-list a { display:block; border:1px solid var(--rule); border-radius:10px; padding:1.4rem; color:var(--ink); text-decoration:none; } .guide-list a:hover { border-color:var(--accent); } .guide-list strong,.guide-list span { display:block; } .guide-list strong { font:600 1.25rem 'Space Grotesk',sans-serif; } .guide-list span { margin:.5rem 0; color:var(--ink-soft); }
