---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title} · Virgil Digital</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={`${title} · Virgil Digital`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Virgil Digital`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Virgil Digital',
      url: Astro.site, email: 'hello@virgildigital.co.uk', description,
      areaServed: 'United Kingdom', founder: { '@type': 'Person', name: 'Virgil Pais' }, priceRange: '££'
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QSVG1Y51HB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QSVG1Y51HB');
    </script>
  </head>

  <body>
    <nav class="top">
      <div class="nav-inner">
        <a href="/" class="brand"><img class="brand-mark" src="/virgil-mark-v2.svg" alt="" width="30" height="30" /><span class="brand-name">VIRGIL <em>DIGITAL</em></span></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-menu"><span></span><span></span><span></span></button>
        <div class="nav-links" id="site-menu">
          <a href="/about/">About</a>
          <a href="/services/">Services</a>
          <a href="/work/">Work</a>
          <a href="/guides/">Guides</a>
          <a href="/faq/">FAQ</a>
          <a href="/contact/" class="nav-cta">Get a free audit</a>
        </div>
      </div>
    </nav>

    <main class="wrap page">
      <slot />
    </main>

    <footer>
      <div class="foot-wrap">
        <div class="foot-brand"><span class="kicker">Virgil Digital</span><h2>Make your business easier to choose.</h2><a href="/contact/" class="foot-cta">Start a conversation →</a></div>
        <div class="foot-links"><strong>Explore</strong><a href="/work/">Work</a><a href="/guides/">Guides</a><a href="/faq/">FAQ</a><a href="/process/">Process</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div>
        <div class="foot-links"><strong>Contact</strong><a href="mailto:hello@virgildigital.co.uk">hello@virgildigital.co.uk</a><span>Bristol-based · UK-wide</span><span>© Virgil Digital</span></div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink:#0F1115;
    --ink-soft:#3D4148;
    --ink-mute:#6B7280;
    --paper:#FFFFFF;
    --paper-alt:#F4F5F7;
    --rule:#E3E5E9;
    --accent:#2F5CFF;
    --accent-dark:#1E3FCC;
    --accent-warm:#D56B4B;
    --accent-mint:#55B994;
  }

  * {
    box-sizing:border-box;
    margin:0;
    padding:0;
  }

  body {
    font-family:'Inter',system-ui,sans-serif;
    background:var(--paper);
    color:var(--ink-soft);
    font-size:17px;
    line-height:1.65;
  }

  .wrap {
    max-width:1000px;
    margin:0 auto;
    padding:0 6%;
  }

  nav.top {
    position:sticky;
    top:0;
    z-index:10;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--rule);
    padding:1.1rem 6%;
  }

  .nav-inner {
    max-width:1000px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }

  .brand {
    display:flex;
    align-items:center;
    gap:.55rem;
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:1.05rem;
    letter-spacing:0.02em;
    color:var(--ink);
    text-decoration:none;
  }

  .brand-name {
    color:var(--ink);
  }

  .brand-name em {
    color:var(--accent);
    font-style:normal;
  }

  .brand-mark {
    display:grid;
    place-items:center;
    width:1.7rem;
    height:1.7rem;
    border-radius:5px;
    background:var(--ink);
    color:#fff;
    font:700 1rem 'Space Grotesk',sans-serif;
    transform:skew(-7deg);
  }

  .nav-links {
    display:flex;
    align-items:center;
    gap:1.75rem;
  }

  .nav-links a {
    color:var(--ink-soft);
    text-decoration:none;
    font-size:0.95rem;
    font-weight:500;
  }

  .nav-links a:hover {
    color:var(--ink);
  }

  .nav-links a:not(.nav-cta) {
    position:relative;
    padding:.35rem 0;
  }

  .nav-links a:not(.nav-cta)::after {
    content:'';
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    height:2px;
    background:var(--accent);
    transform:scaleX(0);
    transform-origin:right;
    transition:transform .2s ease;
  }

  .nav-links a:not(.nav-cta):hover::after,
  .nav-links a[aria-current='page']::after { transform:scaleX(1); transform-origin:left; }

  .menu-toggle { display:none; }
  nav.top { transition:transform .25s ease; }
  nav.top.nav-hidden { transform:translateY(-100%); }

  .nav-cta {
    background:var(--ink);
    color:#fff !important;
    padding:0.55rem 1.1rem;
    border-radius:6px;
  }

  .nav-cta:hover {
    background:var(--accent) !important;
  }

  .page {
    padding:4.5rem 6% 5rem;
  }

  .kicker {
    display:inline-block;
    font-family:'JetBrains Mono',monospace;
    font-size:0.75rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--accent);
    margin-bottom:1rem;
  }

  h1 {
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:clamp(2.4rem,5.2vw,3.6rem);
    line-height:1.08;
    color:var(--ink);
    margin-bottom:1.25rem;
    max-width:780px;
    letter-spacing:-0.01em;
  }

  h1 .accent,
  h2 .accent {
    color:var(--accent);
  }

  h2 {
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:1.6rem;
    color:var(--ink);
    margin:2.5rem 0 1rem;
    letter-spacing:-0.01em;
  }

  h3 {
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:1.1rem;
    color:var(--ink);
    margin-bottom:0.5rem;
  }

  p {
    color:var(--ink-soft);
    max-width:680px;
    margin-bottom:1rem;
  }
    .sr-only {
    position:absolute;
    width:1px;
    height:1px;
    padding:0;
    margin:-1px;
    overflow:hidden;
    clip:rect(0,0,0,0);
    white-space:nowrap;
    border:0;
  }

  .lede {
    font-size:1.2rem;
    color:var(--ink-soft);
    max-width:620px;
    margin-bottom:1.75rem;
  }

  strong {
    color:var(--ink);
    font-weight:600;
  }

  a {
    color:var(--accent);
  }

  table {
    border-collapse:collapse;
    width:100%;
    max-width:760px;
    margin:1.5rem 0;
  }

  th,
  td {
    text-align:left;
    padding:0.9rem 0.75rem;
    border-bottom:1px solid var(--rule);
    font-size:0.95rem;
  }

  th {
    font-family:'JetBrains Mono',monospace;
    font-size:0.7rem;
    letter-spacing:0.05em;
    text-transform:uppercase;
    color:var(--ink-mute);
    font-weight:500;
  }

  td strong {
    color:var(--ink);
  }

  .btn {
    display:inline-block;
    padding:0.9rem 1.6rem;
    background:var(--ink);
    color:#fff;
    text-decoration:none;
    margin-top:0.5rem;
    border-radius:6px;
    font-weight:600;
    font-size:0.95rem;
  }

  .btn:hover {
    background:var(--accent);
  }

  .cards {
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:1.25rem;
    margin:2rem 0;
  }

  .card {
    background:var(--paper-alt);
    border:1px solid var(--rule);
    border-radius:10px;
    padding:1.5rem;
  }

  .card h3 {
    font-size:1rem;
  }

  .card p {
    font-size:0.92rem;
    margin-bottom:0;
    max-width:none;
  }

  .case-study {
    background:var(--paper-alt);
    border:1px solid var(--rule);
    border-radius:12px;
    padding:2rem;
    margin:2rem 0;
  }

  .case-study .kicker {
    margin-bottom:0.6rem;
  }

  .testimonial {
    border-left:3px solid var(--accent);
    padding:0.25rem 0 0.25rem 1.5rem;
    margin:2rem 0;
  }

  .testimonial p {
    font-size:1.1rem;
    color:var(--ink);
    font-style:italic;
    max-width:640px;
  }

  .testimonial cite {
    display:block;
    margin-top:0.75rem;
    font-style:normal;
    font-size:0.9rem;
    color:var(--ink-mute);
  }

  .testimonial cite a {
    color:var(--ink-mute);
    text-decoration:underline;
  }

  .testimonial cite a:hover {
    color:var(--accent);
  }

  .compare-table td:first-child,
  .compare-table th:first-child {
    color:var(--ink);
    font-weight:600;
  }

  .compare-table .win {
    color:var(--accent);
    font-weight:600;
  }

  footer {
    background:#11151f;
    color:#fff;
    padding:3.5rem 6%;
    margin-top:4rem;
    border-top:4px solid var(--accent-warm);
  }

  .foot-wrap {
    max-width:1000px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    gap:3rem;
  }

  .foot-brand { flex:1.5; } .foot-brand h2 { color:#fff; max-width:360px; margin:.2rem 0 1rem; } .foot-brand .kicker { color:#f2bd70; }
  .foot-cta { color:#fff; text-decoration:none; font-weight:600; }
  .foot-links { display:flex; flex-direction:column; gap:.45rem; min-width:130px; font-size:.9rem; } .foot-links strong { color:#fff; margin-bottom:.35rem; } .foot-links a,.foot-links span { color:#b9c0ce; text-decoration:none; } .foot-links a:hover { color:#fff; }

  .case-image { display:block; width:100%; max-height:560px; object-fit:contain; object-position:top; background:var(--paper-alt); border:1px solid var(--rule); border-radius:10px; margin:2rem 0 3rem; }
  .case-mobile-image { display:block; width:min(390px, 100%); max-height:680px; object-fit:contain; object-position:top; background:var(--paper-alt); border:1px solid var(--rule); border-radius:10px; margin:0 0 3rem; }

  @media (max-width:640px) {
    nav.top {
      padding:0.9rem 5%;
    }

    .menu-toggle { display:flex; flex-direction:column; justify-content:center; gap:4px; width:36px; height:36px; align-items:center; border:0; background:transparent; color:var(--ink); cursor:pointer; padding:.5rem; }
    .menu-toggle span { display:block; width:19px; height:2px; border-radius:2px; background:var(--ink); }
    .nav-inner { position:relative; }
    .nav-links { display:none; position:absolute; top:calc(100% + .9rem); right:0; flex-direction:column; align-items:stretch; gap:.4rem; padding:.8rem; min-width:180px; background:var(--paper); border:1px solid var(--rule); border-radius:8px; box-shadow:0 12px 30px rgba(15,17,21,.12); }
    .nav-links.is-open { display:flex; }
    .nav-links a { font-size:.9rem; padding:.45rem .35rem !important; }
    .nav-links a:not(.nav-cta)::after { display:none; }

    .nav-cta {
      padding:0.5rem 0.8rem;
      font-size:0.8rem;
    }

    .brand {
      font-size:0.9rem;
    }
    .brand-mark { width:1.5rem; height:1.5rem; }
    .foot-wrap { flex-direction:column; gap:2rem; }
  }
</style>

<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const siteMenu = document.querySelector('#site-menu');
  const closeMenu = () => {
    siteMenu?.classList.remove('is-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Open navigation menu');
  };
  menuToggle?.addEventListener('click', () => {
    const open = siteMenu?.classList.toggle('is-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  });
  siteMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('click', (event) => {
    if (!siteMenu?.classList.contains('is-open')) return;
    const target = event.target as Node;
    if (!siteMenu.contains(target) && !menuToggle?.contains(target)) closeMenu();
  });
  let previousScroll = window.scrollY;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    const nav = document.querySelector('nav.top');
    if (siteMenu?.classList.contains('is-open')) closeMenu();
    if (currentScroll > 100 && currentScroll > previousScroll) nav?.classList.add('nav-hidden');
    if (currentScroll < previousScroll) nav?.classList.remove('nav-hidden');
    previousScroll = currentScroll;
  }, { passive: true });
</script>
